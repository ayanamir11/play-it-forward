generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  username         String         @unique
  passwordHash     String
  firstName        String
  lastName         String
  dateOfBirth      DateTime
  balance          Decimal        @default(0) @db.Decimal(10, 2)
  selectedCause    CauseCategory?
  isAdmin          Boolean        @default(false)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  resetToken       String?        @unique
  resetTokenExpiry DateTime?
  bets             Bet[]
  charityPots      CharityPot[]
}

model Charity {
  id            String        @id @default(uuid())
  name          String
  causeCategory CauseCategory
  description   String
  website       String?
  logoUrl       String?
  isActive      Boolean       @default(true)
  rotationMonth Int?
  rotationYear  Int?
  createdAt     DateTime      @default(now())
  bets          Bet[]
  charityPots   CharityPot[]

  @@unique([causeCategory, rotationMonth, rotationYear])
}

model Bet {
  id                  String    @id @default(uuid())
  userId              String
  sport               String
  event               String
  pick                String
  betType             BetType
  odds                Int
  wagerAmount         Decimal   @db.Decimal(10, 2)
  potentialPayout     Decimal   @db.Decimal(10, 2)
  status              BetStatus @default(PENDING)
  charityContribution Decimal?  @db.Decimal(8, 2)
  settledAt           DateTime?
  createdAt           DateTime  @default(now())
  charityId           String?
  charity             Charity?  @relation(fields: [charityId], references: [id])
  user                User      @relation(fields: [userId], references: [id])
}

model CharityPot {
  id               String   @id @default(uuid())
  userId           String
  charityId        String
  month            DateTime
  totalContributed Decimal  @default(0) @db.Decimal(10, 2)
  isDisbursed      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  charity          Charity  @relation(fields: [charityId], references: [id])
  user             User     @relation(fields: [userId], references: [id])

  @@unique([userId, charityId, month])
}

enum CauseCategory {
  EDUCATION
  HEALTH
  ENVIRONMENT
  HUMAN_RIGHTS
  POVERTY
}

enum BetStatus {
  PENDING
  WON
  LOST
  VOID
}

enum BetType {
  MONEYLINE
  SPREAD
  TOTAL
}
